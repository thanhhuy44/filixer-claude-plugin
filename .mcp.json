{
    "mcpServers": {
        "antd": {
            "command": "npx",
            "args": [
                "-y",
                "@ant-design/cli",
                "mcp"
            ]
        },
        "playwright": {
            "command": "npx",
            "args": [
                "@playwright/mcp@latest"
            ]
        },
        "shadcn": {
            "command": "npx",
            "args": [
                "shadcn@latest",
                "mcp"
            ]
        }
    }
}